# Gemini API キー（必須: Google AI Studio で発行）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# 使用するモデル（任意: 未設定時の既定値は gemini-3.5-flash-lite）
# レート制限や 503 エラーが続く場合は gemini-3.1-flash-lite などに変更
# AIE_MODEL=gemini-3.5-flash-lite

# 第5回: カスタム RAG 検索 DB のパス（任意: 未設定時は data/rag_data/index.sqlite3）
# AIE_RAG_DB=.cache/rag/custom.sqlite3

# Pydantic AI の起動バナーを非表示にする場合（任意）
# PYDANTIC_AI_NO_BANNER=1
